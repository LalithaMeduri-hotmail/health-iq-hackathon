# Health IQ - local development environment variables.
# Copy to `.env` (gitignored) and fill in values from the Bicep deployment outputs
# (`az deployment group show -g <rg> -n main --query properties.outputs`).
#
# Design decision (docs/lld/8-low-level-design-cross-cutting-platform.md, Section 7.1):
# no secrets/keys in code or config - the backend authenticates to every Azure service with
# DefaultAzureCredential (your `az login` session locally, managed identity in Azure) and reads
# non-identity configuration from Key Vault. AZURE_KEY_VAULT_URI is therefore the only value
# that is strictly required; the rest are optional local overrides / fallbacks.

# --- Identity ---
AZURE_TENANT_ID=

# --- Central configuration source (config.py binds to this Key Vault) ---
AZURE_KEY_VAULT_URI=https://<kv-name>.vault.azure.net/

# --- Optional direct overrides (config.py falls back to Key Vault secrets if unset) ---
AZURE_STORAGE_ACCOUNT_NAME=
AZURE_COSMOS_ENDPOINT=
AZURE_COSMOS_DATABASE_NAME=healthiq
AZURE_SQL_SERVER_FQDN=
AZURE_SQL_DATABASE_NAME=healthiq
AZURE_SEARCH_ENDPOINT=
AZURE_DOCINTEL_ENDPOINT=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-5.4
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-large
APPLICATIONINSIGHTS_CONNECTION_STRING=

# --- App behavior ---
# Uses cached OCR/retrieval fixtures instead of live calls; keep true until Azure resources are seeded.
DEMO_MODE=true
OCR_CONFIDENCE_THRESHOLD=0.75
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Doctor review email (docs/lld/6-low-level-design-doctor-review-pdf-secure-share.md) ---
# Origin the doctor's emailed approval link points back at; must be reachable from their inbox.
PUBLIC_API_BASE_URL=http://localhost:8000
# Leave SMTP_HOST empty to keep the mailer in preview mode: messages are written to
# `.local-mail/*.eml` and the approval URL is logged instead of being sent.
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USERNAME=<your address>,
# SMTP_PASSWORD=<16-char Google app password - requires 2-Step Verification>.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=HealthIQ <no-reply@healthiq.invalid>
SMTP_USE_TLS=true
REVIEW_LINK_TTL_HOURS=168
